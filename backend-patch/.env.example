# Banco de dados
DB_TYPE=postgres           # postgres | mssql | oracle
DB_HOST=localhost
DB_PORT=5432               # 5432=postgres | 1433=mssql | 1521=oracle
DB_USER=efinanceira
DB_PASSWORD=troque-a-senha
DB_NAME=efinanceira        # Oracle: usado como service name só se DB_SID e DB_SERVICE_NAME não forem informados

# Oracle específico (um dos dois; se nenhum for informado, cai para DB_NAME como service name):
# DB_SID=
# DB_SERVICE_NAME=

# SQL Server específico (padrão: true / true):
# DB_ENCRYPT=true
# DB_TRUST_CERT=true

# PostgreSQL específico — SSL (padrão: false; Railway/Heroku costumam exigir true):
# DB_SSL=false

# Aplica as migrations pendentes ao iniciar o servidor (padrão: true). Use false para rodar "npm run migration:run" no deploy.
# DB_RUN_MIGRATIONS=true
# Opcional: loga as queries SQL
# DB_LOGGING=false
# Alternativa apenas para PostgreSQL (tem precedência sobre DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME):
# DATABASE_URL="postgresql://user:password@host:5432/efinanceira"
JWT_SECRET="sua-chave-secreta-minimo-32-caracteres"
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://seu-frontend.railway.app"
ADMIN_URL="https://seu-painel-admin.railway.app"
SETUP_ACTIVATION_CODE="TROQUE-POR-CODIGO-ALEATORIO-FORTE"
SUPER_ADMIN_MASTER_CODE="TROQUE-POR-CODIGO-ALEATORIO-FORTE"

# Certificados de criptografia de lotes da RFB (um por ambiente): pasta com cert-criptografia-producao.cer e
# cert-criptografia-producao-restrita.cer. Vazio = só o padrão empacotado (src/recursos/rfb). No on-premise: config\rfb.
RFB_CERTS_DIR=
# Conferência do certificado do SERVIDOR da RFB (raízes ICP-Brasil + raízes do Node). Desligada até ser testada.
RFB_VERIFICAR_CERTIFICADO_SERVIDOR=false

# Segredo para assinar/validar chaves de licença (JWT). Deve ser igual no painel master e nas instalações on-premise.
LICENSE_SECRET="troque-por-segredo-aleatorio-forte-minimo-32-chars"

# Licença assinada com chave privada/pública (RS256) — recomendado. Gere o par com installer/tools/gerar-chaves-licenca.mjs.
# Painel master (SaaS): LICENSE_PRIVATE_KEY_B64 + LICENSE_PUBLIC_KEY_B64. On-premise: somente LICENSE_PUBLIC_KEY_B64.
# LICENSE_PRIVATE_KEY_B64=
# LICENSE_PUBLIC_KEY_B64=

# Tipo de implantação: "saas" (padrão) ou "on-premise". No on-premise, tenant sem licença ativada recebe 402 LICENCA_NAO_ATIVADA.
DEPLOYMENT_TYPE="saas"

# Chave AES-256 (32 bytes em base64) para criptografar a senha de conexão de cada tenant com seu
# próprio banco (ConexaoCliente / BYODB — ver src/lib/connectionManager.ts). Gere com:
#   openssl rand -base64 32
CONNECTION_CIPHER_KEY=

# Se true, POST /api/auth/selecionar-base testa a conexão com a BaseDados antes de emitir o JWT final
# (mais lento, mas evita selecionar uma base fora do ar). Padrão: false.
VERIFICAR_BASE_NO_LOGIN=false
