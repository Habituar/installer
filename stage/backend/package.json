{
  "name": "efinanceira-backend",
  "version": "1.2.22",
  "description": "Backend completo SaaS para transmissão da e-Financeira à Receita Federal do Brasil (RFB)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copiarSchemas.mjs",
    "start": "node dist/index.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/lib/dataSource.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/lib/dataSource.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/lib/dataSource.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/lib/dataSource.ts",
    "db:migrate": "npm run migration:run",
    "db:seed": "tsx src/seed.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "sax": "^1.6.1",
    "tsx": "^4.21.0",
    "typeorm": "^1.1.1",
    "typescript": "~5.8.2",
    "xml-crypto": "^6.3.2",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "mssql": "^12.7.2",
    "oracledb": "^7.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/sax": "^1.2.7"
  }
}
